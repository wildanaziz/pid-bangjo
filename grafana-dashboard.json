{
  "dashboard": {
    "title": "Vehicle Tracking - CCTV Malang",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Total Vehicles Counted",
        "type": "stat",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "query": "from(bucket: \"vehicle-counts\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"vehicle_count\")\n  |> filter(fn: (r) => r[\"_field\"] == \"total\")\n  |> filter(fn: (r) => r[\"location\"] == \"CCTV-Malang-01\")\n  |> last()",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 50},
                {"color": "red", "value": 100}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Vehicles by Type",
        "type": "bargauge",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "query": "from(bucket: \"vehicle-counts\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"vehicle_count\")\n  |> filter(fn: (r) => r[\"_field\"] == \"car\" or r[\"_field\"] == \"motorcycle\" or r[\"_field\"] == \"bus\" or r[\"_field\"] == \"truck\")\n  |> filter(fn: (r) => r[\"location\"] == \"CCTV-Malang-01\")\n  |> last()\n  |> group(columns: [\"_field\"])",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "displayName": "${__field.name}"
          },
          "overrides": [
            {"matcher": {"id": "byName", "options": "car"}, "properties": [{"id": "color", "value": {"fixedColor": "blue", "mode": "fixed"}}]},
            {"matcher": {"id": "byName", "options": "motorcycle"}, "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]},
            {"matcher": {"id": "byName", "options": "bus"}, "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]},
            {"matcher": {"id": "byName", "options": "truck"}, "properties": [{"id": "color", "value": {"fixedColor": "yellow", "mode": "fixed"}}]}
          ]
        }
      },
      {
        "id": 3,
        "title": "Total Vehicles Over Time",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
        "targets": [
          {
            "query": "from(bucket: \"vehicle-counts\")\n  |> range(start: -6h)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"vehicle_count\")\n  |> filter(fn: (r) => r[\"_field\"] == \"total\")\n  |> filter(fn: (r) => r[\"location\"] == \"CCTV-Malang-01\")\n  |> aggregateWindow(every: 1m, fn: last, createEmpty: false)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Vehicle Types Over Time",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
        "targets": [
          {
            "query": "from(bucket: \"vehicle-counts\")\n  |> range(start: -6h)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"vehicle_count\")\n  |> filter(fn: (r) => r[\"_field\"] == \"car\" or r[\"_field\"] == \"motorcycle\" or r[\"_field\"] == \"bus\" or r[\"_field\"] == \"truck\")\n  |> filter(fn: (r) => r[\"location\"] == \"CCTV-Malang-01\")\n  |> aggregateWindow(every: 1m, fn: last, createEmpty: false)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          }
        }
      }
    ],
    "refresh": "5s",
    "time": {"from": "now-6h", "to": "now"},
    "timepicker": {}
  },
  "overwrite": true
}
